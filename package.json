{
  "name": "inventory-manager",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "installer"
  ],
  "scripts": {
    "setup": "npm run setup --workspace=installer",
    "reset-password": "npm run reset-password --workspace=installer",
    "dev": "concurrently -k -n API,Web \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
